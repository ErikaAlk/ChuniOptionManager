<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChuniOptionManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CHUNITHM Option Manager">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView
            x:Name="RootNav"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="RootNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="MusicNav" Content="歌曲" Tag="Music">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Audio" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CharactersNav" Content="角色" Tag="Characters">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="IssuesNav" Content="排查" Tag="Issues">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Important" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="26,20,26,24" RowDefinitions="Auto,Auto,*" RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="CHUNITHM Option Manager" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="可视化查看和管理 option 文件夹里的歌曲、谱面和角色" Foreground="{ThemeResource SoftTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="PickFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="选择 option" />
                            </StackPanel>
                        </Button>
                        <Button Click="Reload_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Refresh" />
                                <TextBlock Text="重新扫描" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,220,170" ColumnSpacing="12">
                    <TextBox
                        x:Name="OptionRootBox"
                        Header="Option 根目录"
                        IsReadOnly="True"
                        PlaceholderText="选择或自动识别 option 文件夹" />
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        Header="搜索"
                        PlaceholderText="标题 / ID / 作者"
                        TextChanged="SearchBox_TextChanged" />
                    <ComboBox
                        x:Name="DifficultyFilter"
                        Grid.Column="2"
                        Header="难度"
                        SelectionChanged="DifficultyFilter_SelectionChanged">
                        <ComboBoxItem Content="全部" IsSelected="True" />
                        <ComboBoxItem Content="BASIC" />
                        <ComboBoxItem Content="ADVANCED" />
                        <ComboBoxItem Content="EXPERT" />
                        <ComboBoxItem Content="MASTER" />
                        <ComboBoxItem Content="ULTIMA" />
                        <ComboBoxItem Content="WORLD'S END" />
                        <ComboBoxItem Content="文件缺失" />
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid x:Name="MusicPage" RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,190" ColumnSpacing="12">
                            <TextBlock x:Name="SongCountText" FontWeight="SemiBold" Foreground="{ThemeResource SoftTextBrush}" VerticalAlignment="Center" />
                            <ComboBox
                                x:Name="SongSortBox"
                                Grid.Column="1"
                                Header="歌曲排序"
                                SelectedIndex="0"
                                SelectionChanged="SortBox_SelectionChanged">
                                <ComboBoxItem Content="按 sortName" Tag="SortName" />
                                <ComboBoxItem Content="按 ID" Tag="Id" />
                                <ComboBoxItem Content="按标题" Tag="Title" />
                                <ComboBoxItem Content="按包名" Tag="Package" />
                                <ComboBoxItem Content="按最高难度" Tag="Difficulty" />
                                <ComboBoxItem Content="缺失优先" Tag="Missing" />
                            </ComboBox>
                        </Grid>
                        <ListView
                            x:Name="SongGrid"
                            Grid.Row="1"
                            ItemsSource="{x:Bind FilteredSongs, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="SongGrid_ItemClick"
                            SelectionMode="Single"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,8,10" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        MinHeight="182"
                                        Padding="14"
                                        Background="{ThemeResource PanelFillBrush}"
                                        BorderBrush="{ThemeResource PanelStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnDefinitions="112,*,Auto" ColumnSpacing="18">
                                            <Border
                                                Width="108"
                                                Height="154"
                                                Background="{Binding PrimaryBrush}"
                                                BorderBrush="#CCFFFFFF"
                                                BorderThickness="2"
                                                CornerRadius="6">
                                                <Grid Padding="6" RowDefinitions="92,30,*">
                                                    <Border BorderBrush="#F2FFFFFF" BorderThickness="2" Background="#FF111827">
                                                        <Grid>
                                                            <TextBlock
                                                                Text="NO IMAGE"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="#66FFFFFF"
                                                                FontSize="10"
                                                                FontWeight="SemiBold" />
                                                            <Image Source="{Binding JacketSource}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Grid Grid.Row="1" ColumnDefinitions="32,*">
                                                        <Border Background="#FF222B36">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-2">
                                                                <TextBlock Text="LEVEL" FontSize="7" FontWeight="Bold" />
                                                                <TextBlock Text="{Binding PrimaryLevel}" FontSize="16" FontWeight="Black" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="1" Background="{Binding PrimaryBrush}">
                                                            <TextBlock
                                                                Text="{Binding PrimaryDifficulty}"
                                                                Foreground="{Binding PrimaryForeground}"
                                                                FontSize="12"
                                                                FontWeight="Black"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                    <Border Grid.Row="2" Background="#FFF8F5EA" Padding="4,1">
                                                        <TextBlock
                                                            Text="{Binding Title}"
                                                            Foreground="#FF1A1A1A"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            TextAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding Title}"
                                                    FontSize="22"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{Binding CardSubText}"
                                                    Foreground="{ThemeResource SoftTextBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{Binding RelativePath}"
                                                    Foreground="{ThemeResource SoftTextBrush}"
                                                    FontSize="12"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ItemsControl ItemsSource="{Binding EnabledCharts}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding DifficultyBrush}" CornerRadius="4" Padding="8,4">
                                                                <TextBlock
                                                                    Text="{Binding DisplayDifficulty}"
                                                                    Foreground="{Binding DifficultyForeground}"
                                                                    FontSize="12"
                                                                    FontWeight="Bold" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" MinWidth="118" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                                <TextBlock Text="{Binding PrimaryDifficulty}" Foreground="{Binding PrimaryForeground}" FontWeight="Bold" TextAlignment="Right" />
                                                <TextBlock Text="{Binding PrimaryLevel}" FontSize="34" FontWeight="Black" TextAlignment="Right" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                                    <TextBlock Text="管理" Foreground="{ThemeResource SoftTextBrush}" />
                                                    <SymbolIcon Symbol="Forward" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="CharactersPage" Visibility="Collapsed" RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,190,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="CharacterCountText" FontWeight="SemiBold" Foreground="{ThemeResource SoftTextBrush}" VerticalAlignment="Center" />
                            <ComboBox
                                x:Name="CharacterSortBox"
                                Grid.Column="1"
                                Header="角色排序"
                                SelectedIndex="0"
                                SelectionChanged="SortBox_SelectionChanged">
                                <ComboBoxItem Content="按 sortName" Tag="SortName" />
                                <ComboBoxItem Content="按 ID" Tag="Id" />
                                <ComboBoxItem Content="按角色名" Tag="Name" />
                                <ComboBoxItem Content="按作品" Tag="Works" />
                                <ComboBoxItem Content="按 priority" Tag="Priority" />
                                <ComboBoxItem Content="按包名" Tag="Package" />
                            </ComboBox>
                            <Button Grid.Column="2" Click="AddCharacter_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="AddFriend" />
                                    <TextBlock Text="添加角色" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <GridView
                            x:Name="CharacterGrid"
                            Grid.Row="1"
                            ItemsSource="{x:Bind FilteredCharacters, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="CharacterGrid_ItemClick"
                            SelectionMode="Single"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="224"
                                        Height="308"
                                        Margin="6"
                                        Padding="10"
                                        Background="{ThemeResource PanelFillBrush}"
                                        BorderBrush="{ThemeResource PanelStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid RowDefinitions="210,Auto,Auto,*" RowSpacing="6">
                                            <Border Background="#FF101820" CornerRadius="6">
                                                <Grid>
                                                    <TextBlock Text="NO IMAGE" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <Image Source="{Binding ImageSource}" Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2" Text="{Binding Works}" Foreground="{ThemeResource SoftTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="3" Text="{Binding RelativePath}" Foreground="{ThemeResource SoftTextBrush}" FontSize="11" TextWrapping="WrapWholeWords" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>

                    <Grid x:Name="IssuesPage" Visibility="Collapsed" RowDefinitions="Auto,*" RowSpacing="10">
                        <TextBlock x:Name="IssueCountText" FontWeight="SemiBold" Foreground="{ThemeResource SoftTextBrush}" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind Issues, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,4"
                                        Padding="14"
                                        Background="{ThemeResource PanelFillBrush}"
                                        BorderBrush="{ThemeResource PanelStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnDefinitions="88,*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{Binding Severity}" FontWeight="Bold" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource SoftTextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Path}" Foreground="{ThemeResource SoftTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>

        <Grid
            x:Name="SongEditorOverlay"
            Background="#99000000"
            Tapped="SongEditorOverlay_Tapped"
            Visibility="Collapsed">
            <Border
                x:Name="SongEditorPanel"
                Width="560"
                Margin="0,18,22,18"
                Padding="20"
                HorizontalAlignment="Right"
                Background="#F2141921"
                BorderBrush="{ThemeResource PanelStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tapped="SongEditorPanel_Tapped">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SelectedTitle" Text="选择一首歌" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedMeta" Foreground="{ThemeResource SoftTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedPath" Foreground="{ThemeResource SoftTextBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="CloseEditor_Click" VerticalAlignment="Top">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Click="SaveSelectedSong_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <SymbolIcon Symbol="Save" />
                                <TextBlock Text="保存谱面开关" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Click="OpenSelectedFolder_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <SymbolIcon Symbol="Folder" />
                                <TextBlock Text="打开目录" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="DeleteSelectedSong_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="删除歌曲" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl x:Name="SelectedDifficultyStrip" Grid.Row="2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding DifficultyBrush}" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{Binding DisplayDifficulty}" Foreground="{Binding DifficultyForeground}" FontSize="12" FontWeight="Bold" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ListView x:Name="SelectedChartsList" Grid.Row="3">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="126,58,*,98" ColumnSpacing="10" Padding="0,7">
                                    <Border Background="{Binding DifficultyBrush}" CornerRadius="4" Padding="10,6">
                                        <TextBlock Text="{Binding DisplayDifficulty}" Foreground="{Binding DifficultyForeground}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProblemText}" Foreground="{ThemeResource SoftTextBrush}" FontSize="12" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="3" IsOn="{Binding IsEnabled, Mode=TwoWay}" OnContent="启用" OffContent="关闭" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="CharacterEditorOverlay"
            Background="#99000000"
            Tapped="CharacterEditorOverlay_Tapped"
            Visibility="Collapsed">
            <Border
                x:Name="CharacterEditorPanel"
                Width="660"
                Margin="0,18,22,18"
                Padding="20"
                HorizontalAlignment="Right"
                Background="#F2141921"
                BorderBrush="{ThemeResource PanelStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tapped="CharacterEditorPanel_Tapped">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SelectedCharacterName" Text="选择一个角色" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedCharacterMeta" Foreground="{ThemeResource SoftTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedCharacterPath" Foreground="{ThemeResource SoftTextBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="CloseCharacterEditor_Click" VerticalAlignment="Top">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Click="SaveSelectedCharacter_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <SymbolIcon Symbol="Save" />
                                <TextBlock Text="保存角色设置" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Click="OpenSelectedCharacterFolder_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <SymbolIcon Symbol="Folder" />
                                <TextBlock Text="打开目录" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="DeleteSelectedCharacter_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="删除角色" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="250,*" ColumnSpacing="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <ComboBox
                                            x:Name="CharacterImageKindBox"
                                            Header="图片"
                                            SelectedIndex="0"
                                            SelectionChanged="CharacterImageKindBox_SelectionChanged">
                                            <ComboBoxItem Content="big" Tag="big" />
                                            <ComboBoxItem Content="small" Tag="small" />
                                            <ComboBoxItem Content="thumb" Tag="thumb" />
                                        </ComboBox>
                                        <TextBlock
                                            x:Name="CharacterImageKindText"
                                            Grid.Column="1"
                                            Text="big.dds"
                                            Foreground="{ThemeResource SoftTextBrush}"
                                            VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Border Height="250" Background="#FF101820" BorderBrush="{ThemeResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <TextBlock
                                                x:Name="CharacterPreviewMissingText"
                                                Text="NO IMAGE"
                                                Foreground="#66FFFFFF"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold" />
                                            <Image x:Name="SelectedCharacterImage" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="CharacterImageKeyText" Foreground="{ThemeResource SoftTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectedCharacterImagePath" Foreground="{ThemeResource SoftTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBox x:Name="CharacterNameBox" Header="name/str" />
                                    <TextBox x:Name="CharacterSortNameBox" Header="sortName" />
                                    <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                                        <TextBox x:Name="CharacterWorksIdBox" Header="works/id" />
                                        <TextBox x:Name="CharacterWorksBox" Grid.Column="1" Header="works/str" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <TextBox x:Name="CharacterPriorityBox" Header="priority" />
                                        <TextBox x:Name="CharacterRareTypeBox" Grid.Column="1" Header="rareType" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <ToggleSwitch x:Name="CharacterDefaultHaveSwitch" Header="defaultHave" OnContent="true" OffContent="false" />
                                        <ToggleSwitch x:Name="CharacterDisableSwitch" Grid.Column="1" Header="disableFlag" OnContent="true" OffContent="false" />
                                    </Grid>
                                    <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                                        <TextBox x:Name="CharacterReleaseTagIdBox" Header="releaseTag/id" />
                                        <TextBox x:Name="CharacterReleaseTagBox" Grid.Column="1" Header="releaseTag/str" />
                                    </Grid>
                                    <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                                        <TextBox x:Name="CharacterNetOpenIdBox" Header="netOpen/id" />
                                        <TextBox x:Name="CharacterNetOpenBox" Grid.Column="1" Header="netOpen/str" />
                                    </Grid>
                                    <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                                        <TextBox x:Name="CharacterIllustratorIdBox" Header="illustrator/id" />
                                        <TextBox x:Name="CharacterIllustratorBox" Grid.Column="1" Header="illustrator/str" />
                                    </Grid>
                                    <TextBox
                                        x:Name="CharacterExplainBox"
                                        Header="explainText"
                                        AcceptsReturn="True"
                                        Height="88"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Margin="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Window>
