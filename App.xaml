<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ChuniOptionManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 本项目认领的主题色：紫罗兰 #B44BFF（每个项目一种，表在全局 CLAUDE.md）。
                 不覆盖的话强调色跟着 Windows 个性化设置走，几个 App 摆在一起长得一模一样。
                 Light/Dark 那六档是主色混白 / 混黑 14%、28%、42% 推出来的，别各写各的。 -->
            <Color x:Key="SystemAccentColor">#FFB44BFF</Color>
            <Color x:Key="SystemAccentColorLight1">#FFBE64FF</Color>
            <Color x:Key="SystemAccentColorLight2">#FFC97DFF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFD497FF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF9B40DB</Color>
            <Color x:Key="SystemAccentColorDark2">#FF8236B8</Color>
            <Color x:Key="SystemAccentColorDark3">#FF682C94</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFB44BFF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6B44BFF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCB44BFF" />
            <!-- 强调色按钮上的字维持白：白字对这支紫 3.90:1，黑字才 5.39:1，差不多但白的更像平台惯例 -->
            <SolidColorBrush x:Key="PanelFillBrush" Color="#D9161B22" />
            <SolidColorBrush x:Key="PanelStrokeBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="SoftTextBrush" Color="#B8FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
