<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ChuniOptionManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="AccentGreen">#FF00A985</Color>
            <SolidColorBrush x:Key="PanelFillBrush" Color="#D9161B22" />
            <SolidColorBrush x:Key="PanelStrokeBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="SoftTextBrush" Color="#B8FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
